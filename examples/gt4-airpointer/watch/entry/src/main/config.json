{
  "app": {
    "bundleName": "com.example.gt4counter",
    "vendor": "local",
    "version": {
      "code": 1002006,
      "name": "1.2.6"
    },
    "apiVersion": {
      "compatible": 6,
      "target": 6
    }
  },
  "deviceConfig": {},
  "module": {
    "deviceType": [
      "liteWearable"
    ],
    "reqPermissions": [
      {
        "name": "ohos.permission.ACCELEROMETER",
        "reason": "$string:motion_permission_reason",
        "usedScene": {
          "ability": [
            "default"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.GYROSCOPE",
        "reason": "$string:motion_permission_reason",
        "usedScene": {
          "ability": [
            "default"
          ],
          "when": "inuse"
        }
      }
    ],
    "distro": {
      "deliveryWithInstall": true,
      "moduleName": "entry",
      "moduleType": "entry"
    },
    "abilities": [
      {
        "name": "default",
        "icon": "$media:icon",
        "label": "$string:app_name",
        "type": "page"
      }
    ],
    "js": [
      {
        "name": "default",
        "pages": [
          "pages/index/index",
          "pages/control/control"
        ]
      }
    ]
  }
}

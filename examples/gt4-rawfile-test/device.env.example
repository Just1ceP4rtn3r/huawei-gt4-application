# Copy to repository .local/gt4-airpointer-wifi.env and fill locally.
# Device identifier accepted by Frida USB; use your own paired iPhone.
GT4_FRIDA_DEVICE_ID=YOUR_IPHONE_USB_DEVICE_ID
# Must match an existing trusted entry in repository .local/ssh/known_hosts.
GT4_IPHONE_HOST_KEY_ALIAS=YOUR_IPHONE_TRUSTED_SSH_HOST
GT4_USB_SSH_PORT=2229
